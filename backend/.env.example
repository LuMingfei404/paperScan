# PaperSnap 内容流水线配置（复制为 .env 并填写；.env 已在 .gitignore 中）

# LLM API Key（二选一；不配置则总结使用摘要首句兜底）
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# LLM 服务（默认：有 DEEPSEEK_API_KEY 用 https://api.deepseek.com + deepseek-chat，
#          有 OPENAI_API_KEY 用 https://api.openai.com/v1 + gpt-4o-mini）
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# 内容配置
# PS_CATEGORIES=cs.AI,cs.LG,cs.CV,cs.CL,cs.RO,cs.SE
# PS_MAX_PER_CATEGORY=15
# PS_MAX_TOTAL=40
# PS_DATE=2026-08-22
